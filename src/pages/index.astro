---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubjectMark from "../components/SubjectMark.astro";
import { SITE, SUBJECTS, ECOSYSTEM } from "../config/site";
import terminy from "../data/terminy.json";

// ── Dane ────────────────────────────────────────────────────────────────
const dzialyModules = import.meta.glob<{ default: { slug: string; nazwa: string; count: number }[] }>(
  "../data/dzialy/*.json",
  { eager: true }
);
const zadaniaModules = import.meta.glob<{ default: { typ: string; difficulty: number; rok: number; punkty: number }[] }>(
  "../data/zadania/*.json",
  { eager: true }
);

const subjects = Object.entries(dzialyModules)
  .map(([path, mod]) => {
    const slug = path.match(/\/([\w-]+)\.json$/)![1];
    return { meta: SUBJECTS[slug], dzialy: mod.default.filter((d) => d.count > 0) };
  })
  .filter((s) => s.meta)
  .sort((a, b) => a.meta.name.localeCompare(b.meta.name, "pl"));

const wszystkieZadania = Object.values(zadaniaModules).flatMap((m) => m.default);
const totalZadan = wszystkieZadania.length;
const totalDzialow = subjects.reduce((s, x) => s + x.dzialy.length, 0);
const lata = [...new Set(wszystkieZadania.map((z) => z.rok))].sort((a, b) => a - b);

// ── Wykres 1: anatomia arkusza (typy zadań) ─────────────────────────────
// Podział otwarte/zamknięte jest merytoryczny, nie dekoracyjny — to jedyna
// granica, która realnie zmienia sposób przygotowania. Stąd dwa kolory,
// a nie sześć: kolor koduje grupę, długość słupka koduje liczbę.
const TYPY: { key: string; label: string; grupa: "otwarte" | "zamkniete" }[] = [
  { key: "otwarte-krotkie", label: "Otwarte krótkiej odpowiedzi", grupa: "otwarte" },
  { key: "otwarte-rozszerzone", label: "Otwarte rozszerzonej odpowiedzi", grupa: "otwarte" },
  { key: "zamkniete-abcd", label: "Zamknięte wielokrotnego wyboru", grupa: "zamkniete" },
  { key: "zamkniete-dobierz", label: "Zamknięte na dobieranie", grupa: "zamkniete" },
  { key: "zamkniete-pf", label: "Zamknięte prawda/fałsz", grupa: "zamkniete" },
  { key: "dowod", label: "Dowody", grupa: "otwarte" },
];
const typy = TYPY.map((t) => ({
  ...t,
  n: wszystkieZadania.filter((z) => z.typ === t.key).length,
})).filter((t) => t.n > 0);
const maxTyp = Math.max(...typy.map((t) => t.n));
const nOtwarte = typy.filter((t) => t.grupa === "otwarte").reduce((s, t) => s + t.n, 0);
const procOtwarte = Math.round((nOtwarte / totalZadan) * 100);

// ── Wykres 2: skala trudności (uporządkowana → rampa jednobarwna) ───────
const RAMPA = ["#86b6ef", "#5598e7", "#2a78d6", "#1c5cab", "#104281"];
const trudnosc = [1, 2, 3, 4, 5].map((d) => ({
  poziom: d,
  n: wszystkieZadania.filter((z) => z.difficulty === d).length,
  kolor: RAMPA[d - 1],
}));
const maxTrud = Math.max(...trudnosc.map((t) => t.n));
const procTrudne = Math.round(
  ((trudnosc[3].n + trudnosc[4].n) / totalZadan) * 100
);

// ── Oś czasu: kamienie milowe z terminy.json ────────────────────────────
// Bez znacznika „dziś" — strona jest statyczna, więc taki znacznik
// zestarzałby się między deployami i kłamał.
const MIESIACE = ["stycznia", "lutego", "marca", "kwietnia", "maja", "czerwca", "lipca", "sierpnia", "września", "października", "listopada", "grudnia"];
const pl = (iso: string) => {
  const d = new Date(`${iso}T12:00:00`);
  return `${d.getDate()} ${MIESIACE[d.getMonth()]}`;
};
const rokOf = (iso: string) => new Date(`${iso}T12:00:00`).getFullYear();
const kamienie = [
  { data: terminy.deklaracjaWstepna, tytul: "Deklaracja wstępna", opis: "wybór przedmiotów dodatkowych" },
  { data: terminy.deklaracjaOstateczna, tytul: "Deklaracja ostateczna", opis: "po tym dniu nie zmienisz wyboru" },
  { data: terminy.startIso, tytul: `Start sesji ${terminy.rok}`, opis: "język polski, poziom podstawowy" },
  { data: terminy.egzaminyPR[0].dataIso, tytul: "Pierwsze rozszerzenie", opis: terminy.egzaminyPR[0].przedmiot.toLowerCase() },
  { data: terminy.poprawkowaIso!, tytul: "Sesja poprawkowa", opis: "część pisemna" },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
  },
];
---

<BaseLayout title="Matura rozszerzona — zadania CKE, wymagania, terminy" description={SITE.description} schema={schema}>
  <style>
    /* Palety zwalidowane skryptem validate_palette.js na białej powierzchni karty.
       Kategoryczna (otwarte/zamknięte): CVD ΔE 24,7 · normal ΔE 33,6 — obie PASS.
       Porządkowa (trudność 1–5): monotoniczna jasność, jeden odcień, rozstęp ΔL ≥ 0,06. */
    .viz {
      --viz-otwarte: #2a78d6;
      --viz-zamkniete: #eb6834;
      --viz-grid: #e2e8f0;
      --viz-track: #f1f5f9;
    }
    .viz-bar {
      border-radius: 0 4px 4px 0;
      min-width: 3px;
    }
    .viz-col {
      border-radius: 4px 4px 0 0;
      min-height: 3px;
    }
    /* Klasa zamiast powtarzania ~200 znaków klas Tailwinda przy każdym z 91 chipów
       — to różnica ok. 15 KB w wyjściowym HTML strony głównej. */
    .chip {
      display: inline-flex;
      align-items: baseline;
      gap: 0.375rem;
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      background: #fff;
      padding: 0.375rem 0.625rem;
      font-size: 0.875rem;
      line-height: 1.25rem;
      color: #334155;
    }
    .chip:hover {
      border-color: #818cf8;
      color: #4338ca;
    }
    .chip-n {
      font-size: 0.75rem;
      font-variant-numeric: tabular-nums;
      color: #94a3b8;
    }
  </style>

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="mb-10">
    <h1 class="mb-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
      Matura rozszerzona — zadania, wymagania i strategia
    </h1>
    <p class="mb-6 max-w-2xl text-lg text-slate-600">
      Zadania z arkuszy CKE na poziomie rozszerzonym, pogrupowane działami — z odpowiedzią,
      typową pułapką punktową i pełnym rozwiązaniem. Plus wymagania egzaminacyjne, poradnik
      wyboru rozszerzeń i harmonogram sesji {terminy.rok}.
    </p>

    <dl class="mb-6 grid grid-cols-3 gap-3 sm:max-w-lg">
      <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Zadań</dt>
        <dd class="mt-0.5 text-2xl font-extrabold text-slate-900">{totalZadan}</dd>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Działów</dt>
        <dd class="mt-0.5 text-2xl font-extrabold text-slate-900">{totalDzialow}</dd>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Roczników</dt>
        <dd class="mt-0.5 text-2xl font-extrabold text-slate-900">{lata.length}</dd>
        <dd class="text-xs text-slate-500">{lata[0]}–{lata[lata.length - 1]}</dd>
      </div>
    </dl>

    <div class="flex flex-wrap gap-3">
      <a href="/zadania/" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">
        Przeglądaj zadania →
      </a>
      <a href="/wybor-rozszerzen/" class="rounded-lg border border-indigo-200 bg-white px-4 py-2 text-sm font-semibold text-indigo-700 hover:border-indigo-400">
        Co wybrać na rozszerzenie? →
      </a>
      <a href="/terminy/" class="rounded-lg border border-indigo-200 bg-white px-4 py-2 text-sm font-semibold text-indigo-700 hover:border-indigo-400">
        Terminy {terminy.rok} →
      </a>
    </div>
  </section>

  <!-- ── Anatomia arkusza ──────────────────────────────────────────── -->
  <section class="viz mb-10">
    <h2 class="mb-1 text-xl font-bold">Jak zbudowany jest arkusz rozszerzony</h2>
    <p class="mb-5 max-w-2xl text-sm text-slate-600">
      Policzone na {totalZadan} zadaniach z arkuszy CKE z lat {lata[0]}–{lata[lata.length - 1]},
      które mamy w bazie. To nie jest opinia o tym, jak „powinna" wyglądać matura rozszerzona —
      to rozkład tego, co faktycznie było na arkuszach.
    </p>

    <div class="grid gap-4 lg:grid-cols-2">
      <!-- Typy zadań -->
      <figure class="rounded-xl border border-slate-200 bg-white p-5">
        <figcaption class="mb-1 font-semibold text-slate-900">Typy zadań</figcaption>
        <p class="mb-4 text-sm text-slate-600">
          <strong class="text-slate-900">{procOtwarte}% zadań to zadania otwarte.</strong>
          Na rozszerzeniu nie da się „strzelać" — trzeba umieć zapisać rozumowanie.
        </p>

        <div class="mb-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-600">
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-sm" style={`background:var(--viz-otwarte)`}></span>
            otwarte
          </span>
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-sm" style={`background:var(--viz-zamkniete)`}></span>
            zamknięte
          </span>
        </div>

        <ul class="space-y-2.5">
          {typy.map((t) => (
            <li>
              <div class="mb-1 flex items-baseline justify-between gap-3 text-sm">
                <span class="text-slate-700">{t.label}</span>
                <span class="shrink-0 font-semibold tabular-nums text-slate-900">{t.n}</span>
              </div>
              <div class="h-2 rounded-sm" style={`background:var(--viz-track)`}>
                <div
                  class="viz-bar h-2"
                  style={`width:${Math.max(1.5, (t.n / maxTyp) * 100)}%;background:var(--viz-${t.grupa})`}
                  title={`${t.label}: ${t.n} zadań (${Math.round((t.n / totalZadan) * 100)}%)`}
                ></div>
              </div>
            </li>
          ))}
        </ul>
      </figure>

      <!-- Trudność -->
      <figure class="rounded-xl border border-slate-200 bg-white p-5">
        <figcaption class="mb-1 font-semibold text-slate-900">Rozkład trudności</figcaption>
        <p class="mb-4 text-sm text-slate-600">
          <strong class="text-slate-900">{procTrudne}% zadań ma poziom 4 lub 5.</strong>
          Środek skali jest tu wyjątkiem, nie regułą — stąd sens powtarzania działami,
          a nie całymi arkuszami.
        </p>

        {/* Wysokości w pikselach, nie w procentach: słupek siedzi we flex-column
            bez ustalonej wysokości, więc height:% nie miałoby się do czego odnieść
            i kolumny zapadały się do zera. */}
        <div class="flex items-end gap-2.5">
          {trudnosc.map((t) => (
            <div class="flex flex-1 flex-col items-center">
              <span class="mb-1 text-xs font-semibold tabular-nums text-slate-900">{t.n}</span>
              <div
                class="viz-col w-full"
                style={`height:${Math.max(4, Math.round((t.n / maxTrud) * 112))}px;background:${t.kolor}`}
                title={`Poziom ${t.poziom}: ${t.n} zadań (${Math.round((t.n / totalZadan) * 100)}%)`}
              ></div>
              <span class="mt-1.5 text-xs text-slate-500">{t.poziom}</span>
            </div>
          ))}
        </div>
        <p class="mt-3 text-xs text-slate-500">
          Skala 1–5 nadana przy opracowywaniu zadań: 1 — rachunek odtwórczy, 5 — zadanie
          wymagające złożenia kilku wymagań naraz.
        </p>
      </figure>
    </div>
  </section>

  <!-- ── Oś czasu ──────────────────────────────────────────────────── -->
  <section class="mb-10">
    <h2 class="mb-1 text-xl font-bold">Droga do matury {terminy.rok}</h2>
    <p class="mb-5 max-w-2xl text-sm text-slate-600">
      Daty z komunikatu dyrektora CKE z 20 sierpnia 2026 r. Dwie pierwsze są ważniejsze, niż się wydaje w klasie
      maturalnej — po deklaracji ostatecznej wyboru przedmiotów nie da się już zmienić.
    </p>

    <ol class="relative border-l-2 border-slate-200 pl-6">
      {kamienie.map((k, i) => (
        <li class={i === kamienie.length - 1 ? "relative" : "relative pb-6"}>
          <span
            class="absolute -left-[31px] top-1 h-3 w-3 rounded-full border-2 border-white"
            style={`background:${i < 2 ? "#2a78d6" : "#94a3b8"}`}
            aria-hidden="true"></span>
          <p class="text-sm font-semibold text-slate-900">
            {pl(k.data)} {rokOf(k.data)}
          </p>
          <p class="text-sm text-slate-700">{k.tytul}</p>
          <p class="text-xs text-slate-500">{k.opis}</p>
        </li>
      ))}
    </ol>

    <a href="/terminy/" class="mt-4 inline-block text-sm font-semibold text-indigo-700 hover:underline">
      Pełny harmonogram wszystkich rozszerzeń →
    </a>
  </section>

  <!-- ── Przedmioty ────────────────────────────────────────────────── -->
  <section class="mb-10">
    <h2 class="mb-4 text-xl font-bold">Przedmioty rozszerzone</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {subjects.map(({ meta, dzialy }) => {
        const n = dzialy.reduce((a, d) => a + d.count, 0);
        const maxD = Math.max(...dzialy.map((d) => d.count));
        return (
          <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-4">
            <div class="mb-2 flex items-center gap-2.5">
              <span class="text-indigo-700"><SubjectMark slug={meta.slug} /></span>
              <a href={`/${meta.slug}/`} class="text-lg font-bold hover:text-indigo-700">{meta.name}</a>
            </div>

            {/* Rozkład zadań w działach — jedna seria, więc jeden kolor.
                Sylwetka słupków różnicuje karty bez sięgania po dziewiąty odcień. */}
            <div
              class="mb-2 flex items-end gap-[2px]"
              title={`${meta.name}: ${n} zadań w ${dzialy.length} działach`}
            >
              {dzialy.map((d) => (
                <span
                  class="flex-1 rounded-t-[2px] bg-indigo-200"
                  style={`height:${Math.max(4, Math.round((d.count / maxD) * 32))}px`}
                ></span>
              ))}
            </div>

            <p class="mb-3 text-sm text-slate-500">{n} zadań w {dzialy.length} działach</p>
            <div class="mt-auto flex flex-wrap gap-x-3 gap-y-1 text-sm">
              <a href={`/${meta.slug}/zadania/`} class="font-medium text-indigo-700 hover:underline">Zadania</a>
              <a href={`/${meta.slug}/wymagania/`} class="font-medium text-indigo-700 hover:underline">Wymagania</a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- ── Wszystkie działy (siatka chipów; wszystkie linki zachowane) ── -->
  <section class="mb-10">
    <h2 class="mb-1 text-xl font-bold">Wszystkie działy</h2>
    <p class="mb-5 max-w-2xl text-sm text-slate-600">
      {totalDzialow} działów tematycznych. Liczba przy nazwie to liczba zadań z arkuszy CKE,
      które w danym dziale zebraliśmy.
    </p>

    {subjects.map(({ meta, dzialy }) => (
      <div class="mb-5">
        <h3 class="mb-2 flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-slate-500">
          <span class="text-slate-400"><SubjectMark slug={meta.slug} class="h-4 w-4" /></span>
          <a href={`/${meta.slug}/zadania/`} class="hover:text-indigo-700">{meta.name}</a>
        </h3>
        <ul class="flex flex-wrap gap-1.5">
          {dzialy.map((d) => (
            <li>
              <a href={`/${meta.slug}/zadania/${d.slug}/`} class="chip" title={d.nazwa}>
                {d.nazwa.split(":")[0]}
                <span class="chip-n">{d.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <aside class="rounded-xl border border-indigo-200 bg-indigo-50 p-5">
    <p class="font-semibold text-indigo-900">Chcesz rozwiązywać zadania interaktywnie?</p>
    <p class="mt-1 text-sm text-indigo-800">
      Tutaj masz zadania do przejrzenia i powtórki. W aplikacji Matury-Online.pl rozwiążesz je
      z licznikiem czasu, sprawdzaniem odpowiedzi i śledzeniem postępów działami.
    </p>
    <a href={ECOSYSTEM.app} class="mt-3 inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">
      Przejdź do aplikacji →
    </a>
  </aside>
</BaseLayout>
